# EstateAI AI service — environment configuration
# Copy to .env for local runs. The service also reads ../../.env (repo root).

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
LOG_JSON=true

# --- service-to-service auth (must match apps/api AI_SERVICE_TOKEN) ---
AI_SERVICE_TOKEN=dev-insecure-service-token-change-me
FASTIFY_API_URL=http://localhost:3000
FASTIFY_CALLBACK_TIMEOUT_S=15

# --- LLM (Anthropic only in Phase 31) ---
# Leave ANTHROPIC_API_KEY empty to run with the deterministic fake model.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# --- database (read-only usage + AiPy* trace tables) ---
DATABASE_URL=postgresql://estateai:estateai@localhost:5432/estateai
DB_POOL_MIN=1
DB_POOL_MAX=5

# --- redis (ai:py: namespace only) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_NAMESPACE=ai:py:

# --- RAG ---
EMBEDDING_DIMENSION=1536
RAG_TOP_K=5
RAG_MIN_SCORE=0.0

# --- graph ---
GRAPH_CHECKPOINT_BACKEND=postgres
GRAPH_NODE_MAX_RETRIES=1

# --- Phase 33: planner / debate / reflection ---
ANTHROPIC_MODEL=claude-sonnet-4-5
PLANNER_MAX_REPAIR_ATTEMPTS=2
DEBATE_MAX_ROUNDS=2
REFLECTION_MAX_ITERATIONS=2
STRUCTURED_OUTPUT_MAX_RETRIES=2
RAG_MAX_CONTEXT_CHARS=4000
RAG_DEDUPE=true
