# Production environment values for apps/web.
#
# NEXT_PUBLIC_* variables are inlined into the client JS bundle at build
# time (see apps/web/Dockerfile's NEXT_PUBLIC_API_URL build ARG) — this file
# is a reference for what value to pass, not something `apps/web` reads at
# container start.
#
#   NEXT_PUBLIC_API_URL=https://your-domain.example docker compose -f docker-compose.prod.yml up -d --build

# Base URL the browser will call — your real public API origin (through
# nginx, not the internal `api:3000` service name). No trailing slash.
NEXT_PUBLIC_API_URL=https://your-domain.example
