# Development environment values for apps/api.
#
# This is the same variable set as `.env.example` (which stays the
# generic/default file `cp`'d by `docs/development.md`) with every value
# pinned to what local development actually wants — safe to use verbatim
# against the `postgres`/`redis` containers `docker-compose.yml` /
# `docker-compose.dev.yml` bring up. Every variable is documented in full
# in `.env.example`; this file only calls out where a production
# deployment (see `production.env.example`) must diverge.
#
#   cp development.env.example .env

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database — matches docker-compose.yml/docker-compose.dev.yml's postgres service
DATABASE_URL="postgresql://estateai:estateai@localhost:5432/estateai?schema=public"

# Redis — matches docker-compose.yml/docker-compose.dev.yml's redis service
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security
BCRYPT_COST=12

# JWT — placeholder values are fine locally; never reuse these in production
JWT_SECRET=dev-only-secret-do-not-use-in-production-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_ISSUER=estateai
JWT_AUDIENCE=estateai-api

# Refresh tokens
REFRESH_TOKEN_TTL_DAYS=30

# Credential encryption (AES-256-GCM, 32-byte key hex-encoded — generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd

# OAuth
OAUTH_STATE_TTL_SECONDS=600

# GitHub OAuth App (create one at https://github.com/settings/developers,
# callback URL below matches the local dev server)
GITHUB_CLIENT_ID=replace-with-your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/oauth/github/callback

# Async job platform
WORKERS_ENABLED=true
JOB_WORKER_COUNT=2
JOB_POLL_INTERVAL_MS=2000
JOB_HEARTBEAT_INTERVAL_MS=15000
JOB_HEARTBEAT_STALE_MS=60000
JOB_HEARTBEAT_CHECK_INTERVAL_MS=30000
JOB_DEFAULT_MAX_ATTEMPTS=5
JOB_RETRY_BACKOFF_MS=60000,300000,900000,1800000,3600000,21600000,86400000

# AI Integration Framework — only the selected AI_PROVIDER's key needs to be
# real; the others may stay blank if that provider is never invoked.
AI_PROVIDER=claude
CLAUDE_API_KEY=replace-with-your-anthropic-api-key
OPENAI_API_KEY=replace-with-your-openai-api-key
GEMINI_API_KEY=replace-with-your-gemini-api-key
AI_DEFAULT_MAX_TOKENS=1024
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_MS=500
AI_REQUEST_TIMEOUT_MS=30000
# Long-Term Memory / RAG (Phase 23) — embedding provider. 'local' needs no
# key and works out of the box; set to 'openai' to use real embeddings
# (reuses OPENAI_API_KEY above).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings

# Production Readiness
# LOG_LEVEL left unset — defaults to 'debug' in development for pretty-printed,
# verbose local logs (see src/config/env.ts).
METRICS_ENABLED=true
CORS_ORIGIN=*
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=1048576

# Cloud Production Readiness
QUEUE_UNHEALTHY_AGE_MS=120000
MEMORY_WARNING_BYTES=1610612736
DISK_WARNING_BYTES=536870912
COMPRESSION_ENABLED=true
# No reverse proxy in front of a bare `pnpm dev` — 'false' is correct here.
TRUSTED_PROXIES=false
