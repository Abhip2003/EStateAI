# Production environment values for apps/api.
#
# Same variable set as `.env.example`/`development.env.example` — every
# variable's meaning is documented in full there. This file only shows what
# each value should look like for a real deployment behind the bundled
# `nginx/nginx.conf` (see `docker-compose.prod.yml`, `docs/DEPLOYMENT.md`).
# Every placeholder below marked "replace" MUST be replaced before going
# live — none of them are safe defaults.
#
#   cp production.env.example apps/api/.env   # then edit every "replace-..." value

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database — docker-compose.prod.yml constructs this from POSTGRES_USER/
# POSTGRES_PASSWORD/POSTGRES_DB automatically; only set this directly if
# pointing at a managed database instead (see DEPLOYMENT.md).
DATABASE_URL="postgresql://estateai:replace-with-a-real-password@postgres:5432/estateai?schema=public"

# Redis — 'redis' is the docker-compose.prod.yml service name; point at a
# managed Redis instance instead if not using the bundled container.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security
BCRYPT_COST=12

# JWT — JWT_SECRET MUST be a real random value, never this placeholder.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-this-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=estateai
JWT_AUDIENCE=estateai-api

# Refresh tokens
REFRESH_TOKEN_TTL_DAYS=30

# Credential encryption (AES-256-GCM, 32-byte key hex-encoded). MUST be a
# real random value — back it up separately from the database (see
# DEPLOYMENT.md's Backup guide: losing this key makes every stored
# Account.credentialCiphertext permanently undecryptable).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=replace-this-with-a-64-character-hex-string-32-bytes

# OAuth
OAUTH_STATE_TTL_SECONDS=600

# GitHub OAuth App — GITHUB_CALLBACK_URL must be the real public URL,
# registered exactly in the GitHub OAuth App's settings.
GITHUB_CLIENT_ID=replace-with-your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-app-client-secret
GITHUB_CALLBACK_URL=https://your-domain.example/oauth/github/callback

# Async job platform — defaults are usually fine; raise JOB_WORKER_COUNT if
# discovery/sync throughput needs it (see DEPLOYMENT.md's Scaling guide).
WORKERS_ENABLED=true
JOB_WORKER_COUNT=2
JOB_POLL_INTERVAL_MS=2000
JOB_HEARTBEAT_INTERVAL_MS=15000
JOB_HEARTBEAT_STALE_MS=60000
JOB_HEARTBEAT_CHECK_INTERVAL_MS=30000
JOB_DEFAULT_MAX_ATTEMPTS=5
JOB_RETRY_BACKOFF_MS=60000,300000,900000,1800000,3600000,21600000,86400000

# AI Integration Framework — only the selected AI_PROVIDER's key needs to be
# real; leave the others blank if unused. Store these in a real secrets
# manager, not source control (see DEPLOYMENT.md's Security checklist).
AI_PROVIDER=claude
CLAUDE_API_KEY=replace-with-your-anthropic-api-key
OPENAI_API_KEY=replace-with-your-openai-api-key
GEMINI_API_KEY=replace-with-your-gemini-api-key
AI_DEFAULT_MAX_TOKENS=1024
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_MS=500
AI_REQUEST_TIMEOUT_MS=30000
# Long-Term Memory / RAG (Phase 23) — embedding provider. 'local' needs no
# key and works out of the box; set to 'openai' to use real embeddings
# (reuses OPENAI_API_KEY above).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings

# Production Readiness
# LOG_LEVEL left unset — defaults to 'info' in production (see
# src/config/env.ts). Set explicitly only to override.
METRICS_ENABLED=true
# MUST be your real apps/web origin(s), comma-separated — never '*' in production.
CORS_ORIGIN=https://your-domain.example
# Sized for the ~30-script verify regression suite (see DECISIONS.md) —
# retune once real production traffic patterns are known.
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=1048576

# Cloud Production Readiness
QUEUE_UNHEALTHY_AGE_MS=120000
# Tune both to the container's actual resource limits, not this repo's default.
MEMORY_WARNING_BYTES=1610612736
DISK_WARNING_BYTES=536870912
COMPRESSION_ENABLED=true
# 'true' is correct for the bundled nginx topology (exactly one reverse-proxy
# hop in front, see docker-compose.prod.yml) — this is what makes rate
# limiting and X-Forwarded-For/X-Request-Id reflect the real client instead
# of nginx's own container IP. Use a CIDR allowlist instead if your real
# topology adds a second hop (e.g. a cloud load balancer in front of nginx).
TRUSTED_PROXIES=true
