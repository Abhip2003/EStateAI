# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL="postgresql://estateai:estateai@localhost:5432/estateai?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security
BCRYPT_COST=12

# JWT
JWT_SECRET=replace-this-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=estateai
JWT_AUDIENCE=estateai-api

# Refresh tokens
REFRESH_TOKEN_TTL_DAYS=30

# Credential encryption (AES-256-GCM, 32-byte key hex-encoded — generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
CREDENTIAL_ENCRYPTION_KEY=replace-this-with-a-64-character-hex-string-32-bytes

# OAuth
OAUTH_STATE_TTL_SECONDS=600

# GitHub OAuth App (create one at https://github.com/settings/developers)
GITHUB_CLIENT_ID=replace-with-your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/oauth/github/callback

# Async job platform
WORKERS_ENABLED=true
JOB_WORKER_COUNT=2
JOB_POLL_INTERVAL_MS=2000
JOB_HEARTBEAT_INTERVAL_MS=15000
JOB_HEARTBEAT_STALE_MS=60000
JOB_HEARTBEAT_CHECK_INTERVAL_MS=30000
JOB_DEFAULT_MAX_ATTEMPTS=5
JOB_RETRY_BACKOFF_MS=60000,300000,900000,1800000,3600000,21600000,86400000

# AI Integration Framework (Phase 7B) — provider selection + credentials.
# Only the selected AI_PROVIDER's key needs to be real; the others may stay
# blank if that provider is never invoked.
AI_PROVIDER=claude
CLAUDE_API_KEY=replace-with-your-anthropic-api-key
OPENAI_API_KEY=replace-with-your-openai-api-key
GEMINI_API_KEY=replace-with-your-gemini-api-key
AI_DEFAULT_MAX_TOKENS=1024
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_MS=500
AI_REQUEST_TIMEOUT_MS=30000

# Long-Term Memory / RAG (Phase 23) — embedding provider. 'local' needs no
# key and works out of the box; set to 'openai' to use real embeddings
# (reuses OPENAI_API_KEY above).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings

# Production Readiness (Phase 11)
# LOG_LEVEL left unset by default — picked automatically from NODE_ENV
# (debug in development, warn in test, info in production). Set explicitly
# to override.
# LOG_LEVEL=info
METRICS_ENABLED=true
# Comma-separated list of allowed origins for the frontend, or '*' for any.
# Set this to your real apps/web origin(s) in production.
CORS_ORIGIN=*
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=1048576

# Cloud Production Readiness (Phase 12)
QUEUE_UNHEALTHY_AGE_MS=120000
MEMORY_WARNING_BYTES=1610612736
DISK_WARNING_BYTES=536870912
COMPRESSION_ENABLED=true
# 'false' (no proxy in front, the safe default), 'true' (trust the
# immediate peer — correct behind exactly one reverse proxy, e.g. this
# repo's own nginx), or a comma-separated allowlist of proxy IPs/CIDRs.
TRUSTED_PROXIES=false

# --- Phase 31: Python AI service delegation ---
# 'typescript' (default) runs the in-process TS agents exactly as before.
# 'python' delegates AI_* jobs and POST /ai/copilot/chat to apps/ai-service.
# The TS agents always remain as the fallback — this is a pure toggle.
AI_SERVICE_MODE=typescript
AI_SERVICE_URL=http://localhost:8000
# Must match apps/ai-service AI_SERVICE_TOKEN. Never logged.
AI_SERVICE_TOKEN=dev-insecure-service-token-change-me
AI_SERVICE_TIMEOUT_MS=60000
