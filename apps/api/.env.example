# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL="postgresql://estateai:estateai@localhost:5432/estateai?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security
BCRYPT_COST=12

# JWT
JWT_SECRET=replace-this-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=estateai
JWT_AUDIENCE=estateai-api

# Refresh tokens
REFRESH_TOKEN_TTL_DAYS=30
